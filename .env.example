# Copy this file to .env and fill it in. .env is ignored by git. Never paste these values into chat or code.

# Needed by the app (Project Settings > API). Use the PUBLIC anon key, not the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used only by `npm run verify`: a throwaway test account that already exists and is confirmed.
VERIFY_EMAIL=
VERIFY_PASSWORD=

# Used only by the Supabase MCP connection in Claude Code. The app never reads these.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
